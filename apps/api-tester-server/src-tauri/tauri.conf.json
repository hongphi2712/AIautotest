{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API-AutoTester",
  "version": "0.1.0",
  "identifier": "dev.api-tester.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "API-AutoTester",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "additionalBrowserArgs": "--disable-component-update --in-process-gpu --disable-crash-reporter --disable-extensions --disable-background-networking --disable-sync --disable-domain-reliability --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OptimizationHints,OptimizationGuideModelDownloading,msEdgeFluentOverlayScrollbar --disable-logging"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
